# Which backend to use: "ollama" (local, default) or "openai"
LABELKIT_PROVIDER=ollama

# Only needed for the OpenAI provider. Never commit a real key.
# OPENAI_API_KEY=sk-...

# Optional overrides
# LABELKIT_BASE_URL=http://localhost:11434/v1
# LABELKIT_VISION_MODEL=qwen2.5vl:3b
# LABELKIT_TEXT_MODEL=qwen2.5:3b
# LABELKIT_REASONING_EFFORT=none   # for "thinking" models like qwen3
# LABELKIT_LANGUAGES=["pt","fr"]          # pt, fr, en, es, de, it, nl
# LABELKIT_MAX_IMAGE_SIDE=1024
